{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wysiwyl",
  "version": "2.0.0",
  "identifier": "be.somethinks.wysiwyl",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wysiwyl",
        "width": 1600,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
